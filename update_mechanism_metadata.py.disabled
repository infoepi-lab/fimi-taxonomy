#!/usr/bin/env python3
"""
Update mechanism QMD files with function metadata from mechanisms.csv
"""
import csv
import os
import re
from pathlib import Path

# Read the mechanisms CSV
mechanisms_data = {}
with open('mechanisms.csv', 'r', encoding='utf-8-sig') as f:
    reader = csv.DictReader(f)
    for row in reader:
        mechanism = row['mechanism']
        function = row['function']
        mechanisms_data[mechanism] = function

print(f"Loaded {len(mechanisms_data)} mechanisms from CSV")

# Process each mechanism QMD file
mechanisms_dir = Path('mechanisms')
updated_count = 0
not_found_count = 0

for qmd_file in mechanisms_dir.glob('*.qmd'):
    if qmd_file.name == 'index.qmd':
        continue

    # Read the file
    content = qmd_file.read_text(encoding='utf-8')

    # Extract title from YAML frontmatter
    title_match = re.search(r'^title:\s*["\']?(.+?)["\']?$', content, re.MULTILINE)
    if not title_match:
        print(f"[WARN] Could not find title in {qmd_file.name}")
        continue

    title = title_match.group(1).strip('"').strip("'")

    # Find the function for this mechanism
    function = mechanisms_data.get(title)

    if not function:
        print(f"[WARN] {title} not found in CSV")
        not_found_count += 1
        continue

    # Check if YAML frontmatter already has function field
    yaml_end = content.find('\n---', 1)
    if yaml_end == -1:
        print(f"[WARN] Could not find YAML end in {qmd_file.name}")
        continue

    yaml_section = content[:yaml_end]

    # Remove old function field if exists
    yaml_section = re.sub(r'\nfunction:.*?\n', '\n', yaml_section)

    # Add function field before closing ---
    yaml_section += f'function: "{function}"\n'

    # Reconstruct content
    new_content = yaml_section + content[yaml_end:]

    # Update the file
    qmd_file.write_text(new_content, encoding='utf-8')
    updated_count += 1
    print(f"[OK] Updated {title} -> {function}")

print(f"\n[OK] Updated {updated_count} mechanisms")
print(f"[WARN] {not_found_count} not found in CSV")
